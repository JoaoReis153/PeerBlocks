<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- %X{node} is the node's address (see LogContext); left out when no node is set -->
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0}%replace( [%X{node}]){' \[\]', ''} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
